# Migration runner reads DATABASE_URL from the environment.
# If DATABASE_URL is not set, run.js falls back to loading infra/.env
# and constructs the URL from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
#
# For a typical local setup you only need infra/.env — no file is required here.
# If you prefer an explicit override, create packages/db/.env with:
#
# DATABASE_URL=postgresql://ct_dev:change_me@localhost:5432/canopytrace_dev
