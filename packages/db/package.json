{
  "name": "@canopytrace/db",
  "version": "0.0.0",
  "private": true,
  "description": "SQL-first database migrations for CanopyTrace",
  "scripts": {
    "migrate:up": "node scripts/run.js up",
    "migrate:down": "node scripts/run.js down 1",
    "migrate:status": "node scripts/status.js",
    "migrate:reset": "node scripts/reset.js",
    "migrate:create": "node scripts/run.js create",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint target for db'",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "build": "echo 'No build target for db'"
  },
  "devDependencies": {
    "@canopytrace/config-ts": "workspace:*",
    "@testcontainers/postgresql": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "dotenv": "^16.0.0",
    "node-pg-migrate": "^8.0.0",
    "pg": "^8.0.0",
    "prettier": "^3.3.3",
    "testcontainers": "^10.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
