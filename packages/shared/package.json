{
  "name": "@canopytrace/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, constants, and utilities for CanopyTrace",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@canopytrace/config-eslint": "workspace:*",
    "@canopytrace/config-ts": "workspace:*",
    "@types/node": "^20.0.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "vitest": "^2.1.5"
  }
}
