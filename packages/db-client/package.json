{
  "name": "@canopytrace/db-client",
  "version": "0.0.0",
  "private": true,
  "description": "Shared PostgreSQL access layer for CanopyTrace",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@canopytrace/shared": "workspace:*",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@canopytrace/config-eslint": "workspace:*",
    "@canopytrace/config-ts": "workspace:*",
    "@testcontainers/postgresql": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^10.2.1",
    "node-pg-migrate": "^8.0.0",
    "prettier": "^3.3.3",
    "testcontainers": "^10.0.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
