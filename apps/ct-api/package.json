{
  "name": "@canopytrace/ct-api",
  "version": "0.0.0",
  "private": true,
  "description": "CanopyTrace REST API — NestJS",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "node dist/main.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@canopytrace/shared": "workspace:*",
    "@nestjs/common": "^11.1.18",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@canopytrace/config-eslint": "workspace:*",
    "@canopytrace/config-ts": "workspace:*",
    "@nestjs/testing": "^11.1.18",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.2.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.5"
  }
}
