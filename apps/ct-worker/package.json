{
  "name": "@canopytrace/ct-worker",
  "version": "0.0.0",
  "private": true,
  "description": "CanopyTrace background worker — outbox consumer and regulatory sync",
  "main": "dist/main.js",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "tsc",
    "start": "node dist/main.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@canopytrace/shared": "workspace:*"
  },
  "devDependencies": {
    "@canopytrace/config-eslint": "workspace:*",
    "@canopytrace/config-ts": "workspace:*",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "prettier": "^3.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  }
}
