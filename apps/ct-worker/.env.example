# CanopyTrace Worker — runtime environment variables
# Copy to .env.local and fill in real values.
# NEVER commit a populated .env file — it is in .gitignore.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# In local dev this is constructed from infra/.env via docker-compose.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://ct_dev:change_me_never_commit@localhost:5432/canopytrace_dev

# ---------------------------------------------------------------------------
# Object storage (MinIO locally, S3 in production)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change_me_never_commit
MINIO_SECRET_KEY=change_me_never_commit

# ---------------------------------------------------------------------------
# Regulatory (Metrc) — leave blank to disable sync
# Sandbox credentials: https://api-sandbox.metrc.com
# ---------------------------------------------------------------------------
METRC_API_KEY=
METRC_SOFTWARE_API_KEY=
METRC_BASE_URL=https://api-sandbox.metrc.com

# ---------------------------------------------------------------------------
# Worker tuning
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=5
OUTBOX_POLL_INTERVAL_MS=1000
