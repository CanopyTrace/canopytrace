# CanopyTrace Web — runtime environment variables
# Copy to .env.local and fill in real values.
# NEVER commit a populated .env file — it is in .gitignore.
#
# Next.js convention:
#   NEXT_PUBLIC_* — exposed to the browser bundle (safe for public values only)
#   All others    — server-side only

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# API
# Must be reachable from the user's browser in production.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# NextAuth.js — generate secret with: openssl rand -hex 32
# ---------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_never_commit
