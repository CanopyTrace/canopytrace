{
  "name": "canopytrace",
  "version": "0.0.0",
  "private": true,
  "description": "CanopyTrace — cannabis compliance platform monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "audit:deps": "pnpm audit --prod",
    "scan:secrets": "gitleaks detect --source .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^6.0.3"
  }
}
