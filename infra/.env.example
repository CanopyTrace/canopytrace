# CanopyTrace local dev environment
# Copy this file to .env and fill in values.
# NEVER commit a populated .env file — it is in .gitignore.
#
# After starting Docker services, apply the database schema with:
#   pnpm db:migrate
# The migration runner constructs DATABASE_URL from POSTGRES_* vars automatically.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=ct_dev
POSTGRES_PASSWORD=change_me_never_commit
POSTGRES_DB=canopytrace_dev

# ---------------------------------------------------------------------------
# MinIO (S3-compatible object storage)
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=ct_minio_dev
MINIO_ROOT_PASSWORD=change_me_never_commit

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development

# API JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=change_me_never_commit

# ct-web NextAuth.js signing secret — generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change_me_never_commit

# Metrc API credentials (sandbox)
# Obtain from: https://api-sandbox.metrc.com
METRC_API_KEY=
METRC_SOFTWARE_API_KEY=
METRC_BASE_URL=https://api-sandbox.metrc.com
